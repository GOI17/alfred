    "installer-tui:check": "cd packages/installer-tui && npm run check",
    "installer-tui:test": "cd packages/installer-tui && npm test",
    "validate:suite-installer": "node scripts/validate-suite-installer.mjs",
    "validate:homebrew": "node scripts/validate-homebrew.mjs",
    "pages:build": "node scripts/build-pages-site.mjs",

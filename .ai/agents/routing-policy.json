{
  "version": "routing-policy@0.2.0",
  "owner": "core",
  "specialists": [
    {
      "id": "developer",
      "triggers": [
        "implement",
        "code change",
        "refactor",
        "bug fix",
        "typo",
        "rename",
        "formatting"
      ]
    },
    {
      "id": "qa",
      "triggers": [
        "test",
        "failing",
        "regression",
        "reproduce"
      ]
    },
    {
      "id": "librarian",
      "triggers": [
        "search",
        "summarize",
        "index",
        "find docs"
      ]
    },
    {
      "id": "architect",
      "triggers": [
        "architecture",
        "ddd",
        "hexagonal",
        "boundary"
      ]
    },
    {
      "id": "reviewer",
      "triggers": [
        "review",
        "risk",
        "security issue",
        "missing tests"
      ]
    }
  ],
  "temporary_agent": {
    "proposal_id": "temporary-specialist-proposal",
    "default_role": "temporary-specialist",
    "permissions": [
      "read_files"
    ],
    "promotion_requires_human_approval": true
  },
  "quick_answer_exception": {
    "question_count": 1,
    "answer_known": true,
    "requires_analysis": false,
    "requires_code": false,
    "requires_actions": false,
    "requires_external_state": false,
    "requires_tools": false,
    "no_declared_work_items": true
  },
  "delegation_default": "required"
}

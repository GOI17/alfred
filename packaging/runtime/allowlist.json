  "packageMetadata": [
    "core",
    "profile-manager",
    "codex-adapter",
    "opencode-adapter",
    "pi-adapter",
    "memory-server",
    "memory",
    "memory-client",
    "memory-mcp",
    "anthropic-adapter",
    "gemini-adapter"
  ],
  "dependencies": {
    "pg": "8.22.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3",
    "nodemailer": "9.1.1"
  },
  "workspaceModules": {
    "@alfred-labs/memory-client": "packages/memory-client",
    "@alfred-labs/memory-mcp": "packages/memory-mcp"

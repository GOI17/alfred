    "packages/console/tui/dashboard.mjs",
    "packages/console-web/src/index.html",
    "packages/memory-openapi/openapi.yaml",
    "packages/anthropic-adapter/bin/*.mjs",
    "packages/anthropic-adapter/src/*.mjs",
    "packages/gemini-adapter/bin/*.mjs",
    "packages/gemini-adapter/src/*.mjs",
    "packages/gemini-adapter/openapi.json",

{
  "name": "@alfred-labs/workspace",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "postinstall": "node scripts/prepare-pty.mjs",
    "dev": "tsx src/server/index.ts --dev",
    "build": "vite build --configLoader runner && tsc -p tsconfig.server.json",
    "start": "node scripts/cli.mjs serve",
    "tc": "tsc --noEmit",
    "test": "cross-env ORCA_BACKGROUND_LAUNCH=1 vitest run && node --test tests/cli.test.mjs",
    "test:e2e": "pnpm build && cross-env ORCA_BACKGROUND_LAUNCH=1 playwright test",
    "browser:install": "playwright install chromium webkit",
    "format": "prettier --write .",
    "check:format": "prettier --check .",
    "lint": "eslint .",
    "test:chat": "playwright test --config playwright.chat.config.ts",
    "lab:chat": "cross-env ORCA_BACKGROUND_LAUNCH=1 tsx tests/chat-lab-server.ts",
    "test:cli": "node --test tests/cli.test.mjs",
    "test:package": "node --test tests/package.test.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.82",
    "@ai-sdk/google": "^4.0.99",
    "@ai-sdk/openai": "^4.0.96",
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.143",
    "class-variance-authority": "^0.7.1",
    "fastify": "^5.12.7",
    "jose": "^6.2.12",
    "jsonc-parser": "^3.3.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.58.0",
    "node-pty": "^1.1.0",
    "playwright": "^1.64.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.9.1",
    "web-push": "^3.6.7",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "selfsigned": "^5.5.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "description": "Independent local workspace for projects, conversations and tools.",
  "bin": {
    "alfred-workspace": "scripts/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/server/server/app.d.ts",
      "default": "./dist/server/server/app.js"
    },
    "./app": {
      "types": "./dist/server/server/app.d.ts",
      "default": "./dist/server/server/app.js"
    },
    "./session-port": {
      "types": "./dist/server/server/session-port.d.ts",
      "default": "./dist/server/server/session-port.js"
    },
    "./session-adapter": {
      "types": "./dist/server/server/session-adapter.d.ts",
      "default": "./dist/server/server/session-adapter.js"
    },
    "./cli": "./scripts/cli.mjs"
  },
  "files": [
    "dist",
    "scripts/cli.mjs",
    "scripts/prepare-pty.mjs",
    "README.md",
    "UPSTREAM.md",
    "upstream-snapshot.json",
    "docs/HARNESSES.md",
    "MIGRATION-VALIDATION.md",
    "validation-baseline.json"
  ]
}
